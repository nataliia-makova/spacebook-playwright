{
  "name": "spacebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run db:prepare && concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:prepare": "tsx server/scripts/prepare.ts",
    "db:reset": "tsx server/scripts/reset.ts",
    "lint": "eslint \"automation/**/*.ts\" playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test:backend": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "6.4.5"
  }
}
